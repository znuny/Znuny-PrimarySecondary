<?xml version="1.0" encoding="utf-8"?>
<otrs_package version="1.0">
    <Name>Znuny-PrimarySecondary</Name>
    <Version>7.3.1</Version>
    <Framework>7.3.x</Framework>
    <Vendor>Znuny GmbH</Vendor>
    <URL>https://www.znuny.org/</URL>
    <License>GNU AFFERO GENERAL PUBLIC LICENSE Version 3, November 2007</License>
    <Description Lang="en">Includes "Ticket Primary/Secondary" feature.</Description>
    <Description Lang="de">Enthält "Ticket Primary/Secondary" Funktionalität.</Description>
    <ChangeLog Version="7.3.1" Date="2026-02-02 10:34:24 +0100">Initial release for Znuny 7.3.</ChangeLog>
    <ChangeLog Version="7.2.3" Date="2025-11-28 14:14:37 +0100">Fixed an issue with invalid recipient being set to send email for secondary tickets when no valid ticket customer user is set.</ChangeLog>
    <ChangeLog Version="7.2.2" Date="2025-10-21 12:35:06 +0200">Fixed: Existing link of secondary ticket other than type "ParentChild" will be deleted before linking it to the primary ticket with link type "ParentChild" to ensure updating this relation.</ChangeLog>
    <ChangeLog Version="7.2.1" Date="2025-08-29 10:40:28 +0200">Initial release for Znuny 7.2.</ChangeLog>
    <ChangeLog Version="7.1.2" Date="2024-12-05 14:26:30 +0100">Added support for deprecated flags "Master" and "SlaveOf" to dynamic field type "PrimarySecondary" when searching for primary and secondary tickets. Dashboards now search for Master and Primary in the Field PrimaryMaster.</ChangeLog>
    <ChangeLog Version="7.1.1" Date="2024-07-26 10:49:36 +0200">Initial release for Znuny 7.1.</ChangeLog>
    <ChangeLog Version="7.0.1" Date="2023-09-25 20:26:18 +0200">Initial release for Znuny 7.0.</ChangeLog>
    <ChangeLog Version="6.5.2" Date="2023-07-13 09:55:15 +0200">Initial release after renaming.</ChangeLog>
    <ChangeLog Version="6.5.1" Date="2023-02-20 14:58:45 +0100">Initital release for Znuny 6.5.</ChangeLog>
    <ChangeLog Version="6.4.1" Date="2022-07-29 11:18:50 +0200">Initital release for Znuny 6.4.</ChangeLog>
    <ChangeLog Version="6.3.2" Date="2022-03-20 10:35:41 +0100">Fixed framework version</ChangeLog>
    <ChangeLog Version="6.3.1" Date="2022-03-18 09:25:32 +0100">Ported to 6.3</ChangeLog>
    <ChangeLog Version="6.2.1" Date="2021-11-09 10:55:12 +0100">Ported to 6.2</ChangeLog>
